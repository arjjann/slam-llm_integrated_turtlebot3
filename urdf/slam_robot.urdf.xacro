<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- <xacro:include filename="base_gazebo.xacro" /> -->
    <xacro:property name="base_length" value="0.6" />
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_height" value="0.2" />
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_length" value="0.05" />

    <material name ="blue">
        <color rgba="0 1 0.5 1"/>
    </material>
    <material name ="black">
        <color rgba="0 0 0 1"/>
    </material>
    <link name="base_link">
        <inertial>
            <mass value="4.0"/>
            <inertia ixx="0.0667" ixy="0" ixz="0" iyy="0.133" iyz="0" izz="0.173"/>
        </inertial>
        <visual>
            <geometry>
                <box size="0.6 0.4 0.2"></box>
            </geometry>
            <origin xyz="0 0 0.2" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
        <collision>
        <geometry>
                <box size="0.6 0.4 0.2"></box>
        </geometry>
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
        </collision>
    </link>
    
    <link name="Rb_wheel_link">
        <inertial>
            <mass value="1.0"/>
            <inertia ixx="0.0027" ixy="0" ixz="0" iyy="0.0027" iyz="0" izz="0.005"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
            <material name="black" />
        </visual>
        <collision>
        <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
                <surface>
                    <friction>
                        <ode>
                            <mu>2.0</mu>
                            <mu2>2.0</mu2>
                            <slip1>0.0</slip1>
                            <slip2>0.0</slip2>
                        </ode>
                    </friction>
                    <contact>
                        <ode>
                            <kp>100000.0</kp>
                            <kd>1.0</kd>
                            <max_vel>1.0</max_vel>
                            <min_depth>0.001</min_depth>
                        </ode>
                    </contact>
                </surface>
        </collision>

    </link>
    <link name="Rf_wheel_link">
        <inertial>
            <mass value="1.0"/>
            <inertia ixx="0.0027" ixy="0" ixz="0" iyy="0.0027" iyz="0" izz="0.005"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
                <surface>
                    <friction>
                        <ode>
                            <mu>2.0</mu>
                            <mu2>2.0</mu2>
                            <slip1>0.0</slip1>
                            <slip2>0.0</slip2>
                        </ode>
                    </friction>
                    <contact>
                        <ode>
                            <kp>100000.0</kp>
                            <kd>1.0</kd>
                            <max_vel>1.0</max_vel>
                            <min_depth>0.001</min_depth>
                        </ode>
                    </contact>
                </surface>
        </collision>
    </link>
    <link name="Lb_wheel_link">
        <inertial>
            <mass value="1.0"/>
            <inertia ixx="0.0027" ixy="0" ixz="0" iyy="0.0027" iyz="0" izz="0.005"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
            <material name="black" />
        </visual>
        <collision>
                 <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
                <surface>
                    <friction>
                        <ode>
                            <mu>2.0</mu>
                            <mu2>2.0</mu2>
                            <slip1>0.0</slip1>
                            <slip2>0.0</slip2>
                        </ode>
                    </friction>
                    <contact>
                        <ode>
                            <kp>100000.0</kp>
                            <kd>1.0</kd>
                            <max_vel>1.0</max_vel>
                            <min_depth>0.001</min_depth>
                        </ode>
                    </contact>
                </surface>
            </collision>
    </link>
    <link name="Lf_wheel_link">
        <inertial>
            <mass value="1.0"/>
            <inertia ixx="0.0027" ixy="0" ixz="0" iyy="0.0027" iyz="0" izz="0.005"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
                <surface>
                    <friction>
                        <ode>
                            <mu>2.0</mu>
                            <mu2>2.0</mu2>
                            <slip1>0.0</slip1>
                            <slip2>0.0</slip2>
                        </ode>
                    </friction>
                    <contact>
                        <ode>
                            <kp>100000.0</kp>
                            <kd>1.0</kd>
                            <max_vel>1.0</max_vel>
                            <min_depth>0.001</min_depth>
                        </ode>
                    </contact>
                </surface>
        </collision>
    </link>
    <link name="lidar_link">
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.0027" ixy="0" ixz="0" iyy="0.0027" iyz="0" izz="0.005"/>
        </inertial>
        <visual>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    </link> 
    <joint name="base_rbwheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="Rb_wheel_link" />
        <origin xyz="-0.2 -0.225 0.1" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>
    <joint name="base_rfwheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="Rf_wheel_link" />
        <origin xyz="0.2 -0.225 0.1" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>
    <joint name="base_lbwheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="Lb_wheel_link" />
        <origin xyz="-0.2 0.225 0.1" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>
    <joint name="base_lfwheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="Lf_wheel_link" />
        <origin xyz="0.2 0.225 0.1" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>
    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0.2 0 0.2975" rpy="0 0 0"/>
    </joint>

<gazebo>
  <plugin
    filename="gz-sim-diff-drive-system"
    name="gz::sim::systems::DiffDrive">

    <!-- LEFT SIDE -->
    <left_joint>base_lfwheel_joint</left_joint>
    <left_joint>base_lbwheel_joint</left_joint>

    <!-- RIGHT SIDE -->
    <right_joint>base_rfwheel_joint</right_joint>
    <right_joint>base_rbwheel_joint</right_joint>

    <wheel_separation>0.45</wheel_separation>
    <wheel_radius>0.1</wheel_radius>

    <topic>cmd_vel</topic>
    <odom_topic>odom</odom_topic>

    <odom_frame>odom</odom_frame>
    <base_frame>base_link</base_frame>
  </plugin>
</gazebo>
>

    
</robot>