<?xml version="1.0"?>
<sdf version="1.6">
  <world name="realistic_house">
    
    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- ================= GROUND ================= -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="ground_collision">
          <geometry>
            <box><size>20 20 0.1</size></box>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <box><size>20 20 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= HALL WALLS ================= -->

    <model name="hall_wall_1">
      <static>true</static>
      <pose>0 2.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="hall_wall_1_collision">
          <geometry>
            <box><size>6 0.2 3</size></box>
          </geometry>
        </collision>
        <visual name="hall_wall_1_visual">
          <geometry>
            <box><size>6 0.2 3</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.3 0.2 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="hall_wall_2">
      <static>true</static>
      <pose>3 0 1.5 0 0 1.57</pose>
      <link name="link">
        <collision name="hall_wall_2_collision">
          <geometry>
            <box><size>5 0.2 3</size></box>
          </geometry>
        </collision>
        <visual name="hall_wall_2_visual">
          <geometry>
            <box><size>5 0.2 3</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.3 0.2 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= FURNITURE ================= -->

    <model name="hall_table">
      <static>true</static>
      <pose>0 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="hall_table_collision">
          <geometry>
            <box><size>1.2 0.6 0.8</size></box>
          </geometry>
        </collision>
        <visual name="hall_table_visual">
          <geometry>
            <box><size>1.2 0.6 0.8</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.1 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="kitchen_rack">
      <static>true</static>
      <pose>-3 -2 0.9 0 0 0</pose>
      <link name="link">
        <collision name="kitchen_rack_collision">
          <geometry>
            <box><size>2 0.6 1.8</size></box>
          </geometry>
        </collision>
        <visual name="kitchen_rack_visual">
          <geometry>
            <box><size>2 0.6 1.8</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="bed">
      <static>true</static>
      <pose>3 -3 0.3 0 0 0</pose>
      <link name="link">
        <collision name="bed_collision">
          <geometry>
            <box><size>2 1.6 0.6</size></box>
          </geometry>
        </collision>
        <visual name="bed_visual">
          <geometry>
            <box><size>2 1.6 0.6</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.6 1</ambient>
          </material>
        </visual>
      </link>
