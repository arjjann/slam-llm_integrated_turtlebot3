    <model name="wardrobe">
      <static>true</static>
      <pose>4 -3 1 0 0 0</pose>
      <link name="link">
        <collision name="wardrobe_collision">
          <geometry>
            <box><size>1.2 0.6 2</size></box>
          </geometry>
        </collision>
        <visual name="wardrobe_visual">
          <geometry>
            <box><size>1.2 0.6 2</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.1 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="toilet_block">
      <static>true</static>
      <pose>-4 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="toilet_collision">
          <geometry>
            <box><size>0.6 0.6 1</size></box>
          </geometry>
        </collision>
        <visual name="toilet_visual">
          <geometry>
            <box><size>0.6 0.6 1</size></box>
          </geometry>
          <material>
